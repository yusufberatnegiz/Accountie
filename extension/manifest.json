{
  "manifest_version": 3,
  "name": "Accountie Luca Doldurucu",
  "version": "0.6.0",
  "description": "Onaylı fişleri Luca Fiş Detayına yazar, ekranla karşılaştırır; son fişi siz kaydedersiniz.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Accountie",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://accountie.app/*",
    "https://www.accountie.app/*",
    "https://*.luca.com.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["https://accountie.app/*", "https://www.accountie.app/*"]
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
