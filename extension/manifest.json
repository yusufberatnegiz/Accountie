{
  "manifest_version": 3,
  "name": "Accountie Luca Doldurucu",
  "version": "0.4.1",
  "description": "Onaylı fişleri Luca Fiş Detayına yazar, ekranla karşılaştırır; son fişi siz kaydedersiniz.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Accountie"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://accountie.vercel.app/*",
    "https://*.luca.com.tr/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
