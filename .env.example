# Yalnızca yer tutucu. Gerçek değerler .env.local veya Vercel ortam değişkenlerinde durur, commit edilmez.
# Hiçbirine NEXT_PUBLIC_ öneki verme: hepsi sunucu tarafı sırrıdır.
DATABASE_URL=postgresql://kullanici:sifre@ornek.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ornek.neonauth.example/neondb/auth
NEON_AUTH_COOKIE_SECRET=en-az-32-karakterlik-rastgele-bir-deger-uretin
ANTHROPIC_API_KEY=sk-ant-yer-tutucu
# Cloudflare Turnstile (giriş/kayıt bot koruması). Site anahtarı herkese açıktır ama sunucudan okunur. Önerilir, zorunlu değil: gizli anahtar boşsa doğrulama atlanır (canlıda sunucu loguna uyarı düşer).
TURNSTILE_SITE_KEY=0x-yer-tutucu-site-anahtari
TURNSTILE_SECRET_KEY=0x-yer-tutucu-gizli-anahtar
